---
import { createKnowledgeGraphModel } from "@noetheca/knowledge-engine";
import KnowledgeGraph from "@noetheca/knowledge-engine/components/KnowledgeGraph.astro";
import KnowledgeLayout from "@noetheca/knowledge-engine/components/KnowledgeLayout.astro";
import relationAudit from "../../relations/cosense-link-audit.json";
import curatedRelations from "../../relations/context-relations.json";
import { extractAestheticsContext } from "../lib/aesthetics-context";
import { buildAestheticsGraphRelations } from "../lib/aesthetics-relations";
import { loadConceptEntries } from "../lib/concept-entries";
import { siteLanguages } from "../lib/languages";
import { conceptRoute, withBase } from "../lib/routes";
import "../styles/aesthetics.css";

const locale = "ja";
const records = (await loadConceptEntries())
  .filter(({ entry }) => entry.data.locale === locale)
  .sort((left, right) =>
    left.entry.data.title.localeCompare(right.entry.data.title, locale),
  );
const chronology: Record<string, number> = {};
const thumbnails: Record<string, string> = {};
const contextFacts: Record<
  string,
  readonly { label: string; value: string }[]
> = {};
for (const { concept, translation } of records) {
  const id = concept.metadata.id;
  const context = extractAestheticsContext(translation.body);
  if (context.chronology !== undefined) {
    chronology[id] = context.chronology;
  }
  if (context.thumbnail !== undefined) {
    thumbnails[id] = context.thumbnail;
  }
  contextFacts[id] = [{ label: "時期", value: context.periodRaw }];
}
const { contextualRelations, relatedById } = buildAestheticsGraphRelations(
  records.map(({ concept }) => concept.metadata.id),
  relationAudit,
  curatedRelations,
);
const graph = createKnowledgeGraphModel(
  records.map(({ entry, concept }) => ({
    id: concept.metadata.id,
    title: entry.data.title,
    summary: entry.data.summary,
    status: entry.data.status,
    href: withBase(conceptRoute(entry.data.locale, concept.metadata.id)),
    prerequisites: concept.metadata.prerequisites,
    related: [
      ...new Set([
        ...concept.metadata.related,
        ...(relatedById.get(concept.metadata.id) ?? []),
      ]),
    ],
  })),
  { contextualRelations },
);
---

<KnowledgeLayout
  title="美学"
  summary="Internet aestheticsと日本語圏の美学ミームを、関係と文脈からたどるnoethecaの知識領域です。"
  locale={locale}
  domain="aesthetics"
  languages={siteLanguages}
  immersive
>
  <KnowledgeGraph
    graph={graph}
    chronology={chronology}
    thumbnails={thumbnails}
    contextFacts={contextFacts}
    controls
    locale={locale}
    title="美学 文脈マップ"
    relationshipMode="contextual"
    initialView="responsive"
    labels={{
      viewportLabel: "美学の関係と文脈をたどるマップ",
      legend: "矢印は、本文から推定した「源流・影響元 → 継承・派生先」を示します",
      relatedLegend: "一点鎖線は、選択した美学に関連する文脈を示します",
      inspectorLabel: "選択した美学の詳細",
      accessibleList: "アクセシブルな美学一覧",
      knowledgeList: "美学一覧",
      articleLabel: "美学の記事",
      articleEyebrow: "美学の記事",
      navigationLabel: "美学の関係と文脈",
      selectedKnowledge: "選択した美学",
      prerequisites: "源流・影響元",
      noPrerequisites: "登録されていません",
      dependents: "継承・派生した美学",
      noDependents: "登録されていません",
      related: "関連する美学・文脈",
      learn: "この美学を読む",
      previous: "源流・影響元",
      next: "継承・派生した美学",
      noKnowledge: "該当する美学はありません",
    }}
  />
</KnowledgeLayout>
