---
import ConceptRelations from "@noetheca/knowledge-engine/components/ConceptRelations.astro";
import KnowledgeLayout from "@noetheca/knowledge-engine/components/KnowledgeLayout.astro";
import {
  getUiStrings,
  type Concept,
  type KnowledgeLanguageOption,
} from "@noetheca/knowledge-engine";
import { render, type CollectionEntry } from "astro:content";
import relationAudit from "../../relations/cosense-link-audit.json";
import curatedRelations from "../../relations/context-relations.json";
import { buildAestheticsGraphRelations } from "../lib/aesthetics-relations";
import { loadConceptEntries } from "../lib/concept-entries";
import { siteLanguages } from "../lib/languages";
import { conceptRoute, withBase } from "../lib/routes";
import "../styles/aesthetics.css";

interface Props {
  entry: CollectionEntry<"concepts">;
  concept: Concept;
  relationTitles: Record<string, string>;
  predecessorIds: string[];
  successorIds: string[];
  relatedIds: string[];
  languages: KnowledgeLanguageOption[];
}

export async function getStaticPaths() {
  const records = await loadConceptEntries();
  const translations = new Map(
    records.map(({ entry, concept }) => [
      `${concept.metadata.id}:${entry.data.locale}`,
      entry,
    ]),
  );
  const conceptIds = new Set(records.map(({ concept }) => concept.metadata.id));
  const { contextualRelations, relatedById } = buildAestheticsGraphRelations(
    conceptIds,
    relationAudit,
    curatedRelations,
  );
  const predecessorById = new Map<string, string[]>(
    [...conceptIds].map((id) => [id, []]),
  );
  const successorById = new Map<string, string[]>(
    [...conceptIds].map((id) => [id, []]),
  );
  for (const { source, target } of contextualRelations) {
    predecessorById.get(target)?.push(source);
    successorById.get(source)?.push(target);
  }

  return records.map(({ entry, concept }) => {
    const conceptId = concept.metadata.id;
    const byLocalizedTitle = (left: string, right: string): number => {
      const leftTitle =
        translations.get(`${left}:${entry.data.locale}`)?.data.title ?? left;
      const rightTitle =
        translations.get(`${right}:${entry.data.locale}`)?.data.title ?? right;
      return leftTitle.localeCompare(rightTitle, entry.data.locale);
    };
    const predecessorIds = [...(predecessorById.get(conceptId) ?? [])].sort(
      byLocalizedTitle,
    );
    const successorIds = [...(successorById.get(conceptId) ?? [])].sort(
      byLocalizedTitle,
    );
    const relatedIds = [...(relatedById.get(conceptId) ?? [])].sort(
      (left, right) => {
        return byLocalizedTitle(left, right);
      },
    );
    const relationTitles = Object.fromEntries(
      [...predecessorIds, ...successorIds, ...relatedIds]
        .map((id) => [
          id,
          translations.get(`${id}:${entry.data.locale}`)?.data.title,
        ])
        .filter((pair): pair is [string, string] => pair[1] !== undefined),
    );
    const languages = siteLanguages.map((language) => ({
      ...language,
      href: translations.has(`${conceptId}:${language.locale}`)
        ? withBase(conceptRoute(language.locale, conceptId))
        : undefined,
    }));
    return {
      params: {
        slug: conceptRoute(entry.data.locale, conceptId),
      },
      props: {
        entry,
        concept,
        relationTitles,
        predecessorIds,
        successorIds,
        relatedIds,
        languages,
      },
    };
  });
}

const {
  entry,
  concept,
  relationTitles,
  predecessorIds,
  successorIds,
  relatedIds,
  languages,
} = Astro.props;
const { Content } = await render(entry);
const locale = entry.data.locale;
const ui = getUiStrings(locale).article;

function relation(id: string) {
  const title = relationTitles[id];
  return {
    id,
    title,
    href: title ? withBase(conceptRoute(locale, id)) : undefined,
  };
}

const sourcePath = entry.filePath?.replaceAll("\\", "/");
const editUrl = sourcePath
  ? `https://github.com/noetheca/aesthetics/edit/main/${sourcePath}`
  : "https://github.com/noetheca/aesthetics";
---

<KnowledgeLayout
  title={entry.data.title}
  summary={entry.data.summary}
  locale={locale}
  domain="aesthetics"
  languages={languages}
>
  <article>
    <p class="eyebrow">{concept.metadata.id.replaceAll("/", " / ")}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>

    <div class="prose">
      <Content />
    </div>

    <ConceptRelations
      prerequisites={predecessorIds.map(relation)}
      successors={successorIds.map(relation)}
      related={relatedIds.map(relation)}
      mode="contextual"
      ariaLabel="美学の関係と文脈"
      labels={{
        prerequisites: "源流・影響元",
        successors: "継承・派生した美学",
        related: "関連する美学・文脈",
        empty: ui.noRelations,
      }}
    />

    <section aria-labelledby="sources">
      <h2 id="sources">{ui.sources}</h2>
      {
        entry.data.sources.length > 0 ? (
          <ul>
            {entry.data.sources.map((source) => (
              <li>
                {typeof source === "string" ? (
                  <a href={source}>{source}</a>
                ) : (
                  <>
                    <a href={source.url}>{source.title}</a>
                    {source.note && <span> — {source.note}</span>}
                  </>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">{ui.sourcesPending}</p>
        )
      }
      <p class="muted">
        移植本文は
        <a href="https://creativecommons.org/licenses/by-sa/4.0/">
          CC BY-SA 4.0
        </a>
        です。外部画像・動画・リンク先は対象外です。
      </p>
    </section>

    <p class="content-state">
      <a href={editUrl}>GitHub</a>
      <a href="https://github.com/noetheca/aesthetics/issues/new/choose">
        {ui.reportIssue}
      </a>
    </p>
  </article>
</KnowledgeLayout>

<style>
  .content-state {
    align-items: center;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-block: 3rem 0;
    padding-block: 0.8rem 0;
  }

  .prose {
    margin-top: 2.5rem;
  }
</style>
